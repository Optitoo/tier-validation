<odoo>
  <record id="view_project_filter_tier_validation" model="ir.ui.view">
    <field name="name">project.project.search.tier.validation</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.view_project" />
    <field name="arch" type="xml">
      <filter name="own_projects" position="after">
        <filter name="needs_review" string="Needs my Review"
          domain="[('reviewer_ids', 'in', uid),
                   ('last_update_status', 'not in', ['on_track', 'done'])]"
          help="Projects waiting for my validation" />
        <filter name="tier_validated" string="Validated"
          domain="[('validation_status', '=', 'validated')]"
          help="Projects validated and ready to go on track" />
      </filter>
    </field>
  </record>
</odoo>
