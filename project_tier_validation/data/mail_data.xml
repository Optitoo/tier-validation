<odoo>
  <record model="mail.message.subtype" forcecreate="1" id="project_tier_validation_requested">
    <field name="name">Tier Validation Requested</field>
    <field name="res_model">project.project</field>
    <field name="internal">True</field>
  </record>
  <record model="mail.message.subtype" forcecreate="1" id="project_tier_validation_accepted">
    <field name="name">Tier Validation Accepted</field>
    <field name="res_model">project.project</field>
